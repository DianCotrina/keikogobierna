---
import Base from '../layouts/Base.astro';
import TrackerCard from '../components/TrackerCard.astro';
import TopicCard from '../components/TopicCard.astro';
import CumplidasRegistry from '../components/CumplidasRegistry.astro';
import HeroBanner from '../components/HeroBanner.astro';
import Stamp from '../components/Stamp.astro';
import { loadPlan, loadTopics, loadGoals, loadTracking, goalStats, topicSummaries, statusOf, fulfilledItems, updatesLog } from '../lib/plan.mjs';
import { formatDateEs } from '../lib/format.mjs';

const plan = loadPlan();
const goals = loadGoals();
const tracking = loadTracking();

const overallStats = goalStats(goals, tracking);
const totalProposals = plan.topics.reduce((sum, topic) => sum + topic.proposals, 0);
const summaries = topicSummaries(plan, goals, tracking);

const highlightIds = ['t1-1.M01', 't2-1.M01', 't3-1.M01'];
const highlights = highlightIds
  .map((id) => goals.find((goal) => goal.id === id))
  .filter((goal) => Boolean(goal))
  .map((goal) => ({ id: goal.id, text: goal.text, status: statusOf(goal.id, tracking) }));

const updatedText = `Actualizado el ${formatDateEs(tracking.updated)}`;
const sourcesLine = `Fuente: Plan de Gobierno oficial ${plan.plan.period}`;

const pillarGroups = plan.pillars.map((pillar) => ({
  pillar,
  topics: summaries.filter((topic) => topic.pillar === pillar.id),
}));

const cumplidas = fulfilledItems(plan, loadTopics(), tracking);

// A log entry names a commitment (t1-1.M01); its topic is the id up to the dot.
const topicById = new Map(plan.topics.map((topic) => [topic.id, topic]));
const updates = updatesLog(tracking).map((entry) => {
  const topic = topicById.get(entry.item.split('.')[0]);
  return { ...entry, topicName: topic?.name, topicSlug: topic?.slug };
});
---

<Base
  title="keikogobierna — Seguimiento del plan de gobierno"
  description="Seguimiento ciudadano e independiente del plan de gobierno 2026–2031: cada compromiso, su avance y sus fuentes, verificado punto por punto."
>
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <HeroBanner />
      <div class="relative mx-auto max-w-6xl px-5 sm:px-8 pt-14 pb-16 sm:pt-20 sm:pb-24 grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-16 items-center">
      <div>
        <p class="hero-in d1 font-mono text-xs sm:text-sm text-tintasuave uppercase tracking-[0.18em]">Seguimiento independiente · Plan de gobierno <span class="whitespace-nowrap">2026–2031</span></p>
        <h1 class="hero-in d2 font-display text-[2.6rem] leading-[1.05] sm:text-6xl lg:text-[4.2rem] mt-5" style="letter-spacing:-0.03em">
          Lo prometido<br>
          <span class="relative inline-block">es deuda.
            <svg class="pen-stroke absolute left-0 -bottom-2 w-full" viewBox="0 0 300 22" fill="none" aria-hidden="true" preserveAspectRatio="none">
              <path d="M4 14 C 60 8, 120 18, 170 12 S 270 8, 296 13" stroke="#141417" stroke-width="5" stroke-linecap="round"/>
            </svg>
          </span>
        </h1>
        <p class="hero-in d3 mt-7 text-lg sm:text-xl leading-[1.7] text-tintasuave max-w-xl">
          Registramos cada compromiso del plan de gobierno, contrastamos su avance con fuentes públicas y lo marcamos con tinta: cumplido, en progreso o sin avance. Punto por punto, con evidencia.
        </p>
        <div class="hero-in d4 mt-9 flex flex-wrap gap-4">
          <a href="#tablero" class="btn-primary font-sans font-semibold bg-tinta text-papel px-6 py-3 rounded shadow-card">Ver el tablero</a>
          <a href="#metodologia" class="btn-ghost btn-outline">Cómo verificamos</a>
        </div>
      </div>

      <!-- Signature tracker card -->
      <div id="tablero" class="hero-in d4">
        <TrackerCard
          stats={overallStats}
          totalProposals={totalProposals}
          highlights={highlights}
          sourcesLine={sourcesLine}
          updatedText={updatedText}
        />
      </div>
      </div>
    </section>

    <!-- Temas del plan -->
    <section id="temas" class="border-t border-tinta/10 bg-white/40">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24">
        <div class="reveal max-w-2xl">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Temas del plan</p>
          <h2 class="font-display text-3xl sm:text-4xl mt-3" style="letter-spacing:-0.03em">El plan, tema por tema</h2>
          <p class="mt-4 text-lg leading-[1.7] text-tintasuave">Cada tema agrupa los compromisos tal como figuran en el documento oficial. El avance se calcula solo con evidencia verificable.</p>
        </div>

        {pillarGroups.map(({ pillar, topics }, index) => (
          <div class:list={['mt-14 sm:mt-16', { 'mt-10 sm:mt-12': index === 0 }]}>
            <div class="reveal flex flex-wrap items-end justify-between gap-x-4 gap-y-1 border-b border-tinta/10 pb-3">
              <p class="font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Pilar {index + 1} · {pillar.name.toUpperCase()}</p>
              <p class="font-mono text-xs text-tintafina">{topics.length} temas</p>
            </div>
            <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
              {topics.map((topic) => (
                <TopicCard
                  name={topic.name}
                  slug={topic.slug}
                  proposals={topic.proposals}
                  progressPct={topic.progressPct}
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Primeros 100 días (teaser) -->
    <section class="border-t border-tinta/10">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-14 sm:py-20">
        <a href="/primeros-100-dias/" class="reveal card-hover group block bg-tinta text-papel rounded-lg shadow-lift p-8 sm:p-10 relative overflow-hidden">
          <div class="absolute inset-0 opacity-25" style="background: radial-gradient(600px 320px at 88% 10%, rgba(200,16,46,0.55), transparent 60%);" aria-hidden="true"></div>
          <div class="relative flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.18em] text-papel/60">El arranque del gobierno</p>
              <h2 class="font-display text-3xl sm:text-4xl mt-3" style="letter-spacing:-0.03em">Los primeros 100 días</h2>
              <p class="mt-3 text-lg leading-[1.7] text-papel/80 max-w-lg">67 compromisos que el plan promete cumplir al inicio del gobierno. La primera prueba de intención, reunida en un solo lugar.</p>
            </div>
            <span class="font-sans font-semibold text-papel border-[1.5px] border-papel/40 rounded px-6 py-3 whitespace-nowrap shrink-0 transition-colors group-hover:bg-papel group-hover:text-tinta">Ver la lista →</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Registro de cumplidas -->
    <section id="cumplidas" class="border-t border-tinta/10 bg-white/40 scroll-mt-6">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-14 sm:py-20 grid lg:grid-cols-[0.9fr_1.1fr] gap-10 items-start">
        <div class="reveal">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Lo entregado</p>
          <h2 class="font-display text-3xl sm:text-4xl mt-3" style="letter-spacing:-0.03em">Registro de cumplidas</h2>
          <p class="mt-4 text-lg leading-[1.7] text-tintasuave">Cada propuesta certificada como cumplida, con la evidencia que lo respalda. Sin evidencia no hay certificación.</p>
        </div>
        <div class="reveal">
          <CumplidasRegistry total={cumplidas.total} byPillar={cumplidas.byPillar} items={cumplidas.items} />
        </div>
      </div>
    </section>

    <!-- Metodología -->
    <section id="metodologia" class="border-t border-tinta/10">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24 grid lg:grid-cols-[0.9fr_1.1fr] gap-12">
        <div class="reveal">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Metodología</p>
          <h2 class="font-display text-3xl sm:text-4xl mt-3" style="letter-spacing:-0.03em">Con evidencia, no con opiniones</h2>
          <p class="mt-4 text-lg leading-[1.7] text-tintasuave">Ningún estado se asigna sin una fuente pública enlazada. Si la evidencia cambia, el estado cambia — y queda registrado el historial.</p>
        </div>
        <ol class="space-y-6">
          <li class="reveal flex gap-5 bg-white rounded-lg border border-tinta/10 shadow-card p-6">
            <span class="font-mono text-sm font-semibold text-rojo shrink-0 mt-0.5">01</span>
            <div>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <h3 class="font-sans font-bold">Extraemos cada compromiso</h3>
                <span class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-tintafina">Automático</span>
              </div>
              <p class="mt-1.5 text-sm leading-[1.7] text-tintasuave">Del plan inscrito ante el JNE salen 764 compromisos: 632 propuestas, 67 acciones de los primeros 100 días y 65 metas al 2031. Cada uno conserva el texto tal como figura en el documento.</p>
            </div>
          </li>
          <li class="reveal flex gap-5 bg-white rounded-lg border border-tinta/10 shadow-card p-6">
            <span class="font-mono text-sm font-semibold text-rojo shrink-0 mt-0.5">02</span>
            <div>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <h3 class="font-sans font-bold">Rastreamos El Peruano cada día</h3>
                <span class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-tintafina">Automático</span>
              </div>
              <p class="mt-1.5 text-sm leading-[1.7] text-tintasuave">Un programa compara las normas del diario oficial con el texto de cada compromiso y anota las coincidencias para revisión. Sin inteligencia artificial: solo coincidencias de texto que cualquiera puede rehacer.</p>
            </div>
          </li>
          <li class="reveal flex gap-5 bg-white rounded-lg border border-tinta/10 shadow-card p-6">
            <span class="font-mono text-sm font-semibold text-rojo shrink-0 mt-0.5">03</span>
            <div>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <h3 class="font-sans font-bold">Una persona revisa y certifica</h3>
                <span class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-rojo bg-rojo/10 px-2 py-0.5 rounded">Revisión humana</span>
              </div>
              <p class="mt-1.5 text-sm leading-[1.7] text-tintasuave">Ninguna máquina asigna un estado. Una persona revisa cada coincidencia, la contrasta con otras fuentes oficiales —MEF, INEI, Congreso— cuando el compromiso lo exige, y recién ahí marca: cumplida, en progreso, sin avance o incumplida.</p>
              <p class="mt-2 font-mono text-[0.65rem] leading-[1.7] text-tintafina">En evaluación: un asistente de recuperación (RAG) que acerque al revisor las normas y antecedentes relacionados. La decisión seguirá siendo de una persona.</p>
            </div>
          </li>
          <li class="reveal flex gap-5 bg-white rounded-lg border border-tinta/10 shadow-card p-6">
            <span class="font-mono text-sm font-semibold text-rojo shrink-0 mt-0.5">04</span>
            <div>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <h3 class="font-sans font-bold">Queda por escrito y a la vista</h3>
                <span class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-tintafina">Público</span>
              </div>
              <p class="mt-1.5 text-sm leading-[1.7] text-tintasuave">Cada estado se publica con su fecha y su fuente enlazada. Los datos se descargan completos y el código que hace el seguimiento es público: el camino queda abierto a quien quiera auditarlo.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Actualizaciones -->
    <section id="actualizaciones" class="border-t border-tinta/10 bg-white/40">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24">
        <div class="reveal">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Registro</p>
          <h2 class="font-display text-3xl sm:text-4xl mt-3" style="letter-spacing:-0.03em">Últimas actualizaciones</h2>
        </div>

        <ul class="mt-10 divide-y divide-tinta/10 bg-white rounded-lg border border-tinta/10 shadow-card">
          {updates.length === 0 ? (
            <li class="reveal flex items-center gap-6 p-6">
              <p class="flex-1 font-mono text-sm text-tintasuave">Aún no hay actualizaciones registradas. El seguimiento comienza con el gobierno en funciones.</p>
            </li>
          ) : updates.map((entry) => (
            <li class="reveal p-6">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <Stamp status={entry.status} />
                <time datetime={entry.date} class="font-mono text-xs text-tintafina">{formatDateEs(entry.date)}</time>
              </div>
              <p class="mt-2.5 text-sm leading-[1.7]">{entry.text}</p>
              {entry.topicSlug && (
                <p class="mt-1.5 font-mono text-[0.65rem] text-tintafina">
                  <a href={`/temas/${entry.topicSlug}/`} class="nav-link">{entry.topicName}</a>
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

  </main>
</Base>
