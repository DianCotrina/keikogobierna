---
import Base from '../layouts/Base.astro';
---

<Base
  title="Página no encontrada — keikogobierna"
  description="Esta dirección no existe en keikogobierna. Sigue por el resumen, los primeros 100 días o los temas del plan."
  noindex
>
  <main>
    <section class="mx-auto max-w-4xl px-5 sm:px-8 pt-16 pb-24 sm:pt-24">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Error 404</p>
      <h1 class="font-display text-4xl sm:text-5xl mt-4" style="letter-spacing:-0.03em">Esta página no existe</h1>
      <p class="mt-6 text-lg leading-[1.7] text-tintasuave max-w-xl">
        Revisa la dirección: puede estar mal escrita o la página pudo cambiar de lugar. También puedes buscar un compromiso con el buscador de arriba.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="/" class="btn-primary font-sans font-semibold bg-tinta text-papel px-6 py-3 rounded shadow-card">Ir al resumen</a>
        <a href="/primeros-100-dias/" class="btn-ghost btn-outline">Ver los primeros 100 días</a>
        <a href="/#temas" class="btn-ghost btn-outline">Ver los temas</a>
      </div>
    </section>
  </main>
</Base>
