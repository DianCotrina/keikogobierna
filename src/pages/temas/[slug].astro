---
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import PenProgress from '../../components/PenProgress.astro';
import GoalRow from '../../components/GoalRow.astro';
import {
  loadPlan,
  loadTopics,
  loadGoals,
  loadTracking,
  statusOf,
  topicSummaries,
} from '../../lib/plan.mjs';

export function getStaticPaths() {
  const plan = loadPlan();
  const goals = loadGoals();
  const tracking = loadTracking();
  const summaries = topicSummaries(plan, goals, tracking);

  return summaries.map((topic, index) => ({
    params: { slug: topic.slug },
    props: {
      topic,
      prev: summaries[index - 1] ?? null,
      next: summaries[index + 1] ?? null,
    },
  }));
}

interface TopicSummary {
  id: string;
  slug: string;
  name: string;
  pillar: string;
  pillarName: string;
  proposals: number;
  first_100_days: number;
  goals: number;
  progressPct: number;
}

interface Props {
  topic: TopicSummary;
  prev: TopicSummary | null;
  next: TopicSummary | null;
}

const { topic, prev, next } = Astro.props;

const topics = loadTopics();
const goals = loadGoals();
const tracking = loadTracking();

const topicFile = topics.get(topic.id);
const topicGoals = goals.filter((goal) => goal.topic === topic.id);
const pillarIndex = Number(topic.pillar.slice(1));

const title = `${topic.name} — keikogobierna`;
const description = `Seguimiento del tema ${topic.name} del plan de gobierno 2026–2031: ${topic.goals} metas, ${topic.proposals} propuestas verificables.`;
---

<Base title={title} description={description}>
  <main>
    <!-- Masthead -->
    <section class="mx-auto max-w-4xl px-5 sm:px-8 pt-10 pb-10 sm:pt-14">
      <a href="/" class="nav-link font-mono text-xs text-tintasuave inline-flex items-center gap-2">← Volver al tablero</a>
      <p class="mt-7 font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Pilar {pillarIndex} · {topic.pillarName} · Tema {topicFile.doc_section}</p>
      <h1 class="relative inline-block font-display text-4xl sm:text-5xl mt-4 pb-3" style="letter-spacing:-0.03em">
        {topic.name}
        <svg class="pen-stroke absolute left-0 bottom-0 w-full h-3" viewBox="0 0 300 22" fill="none" aria-hidden="true" preserveAspectRatio="none">
          <path d="M4 14 C 60 8, 120 18, 170 12 S 270 8, 296 13" stroke="#141417" stroke-width="5" stroke-linecap="round"/>
        </svg>
      </h1>
      <div class="mt-9 max-w-md">
        <PenProgress pct={topic.progressPct} label={`Avance del tema: ${topic.progressPct} por ciento`} />
        <p class="mt-3 font-mono text-xs text-tintasuave">{topic.progressPct}% de avance · {topic.goals} metas al 2031</p>
      </div>
    </section>

    <!-- Metas al 2031 -->
    <section class="border-t border-tinta/10 bg-white/40">
      <div class="mx-auto max-w-4xl px-5 sm:px-8 py-14 sm:py-16">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Expediente</p>
        <h2 class="font-display text-2xl sm:text-3xl mt-3" style="letter-spacing:-0.03em">Metas al 2031</h2>
        <ul class="mt-8 divide-y divide-tinta/10 bg-white rounded-lg border border-tinta/10 shadow-card px-6">
          {topicGoals.map((goal) => (
            <GoalRow text={goal.text} indicator={goal.indicator} status={statusOf(goal.id, tracking)} />
          ))}
        </ul>
      </div>
    </section>

    <!-- Propuestas -->
    <section class="border-t border-tinta/10">
      <div class="mx-auto max-w-4xl px-5 sm:px-8 py-14 sm:py-16">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Registro completo</p>
        <h2 class="font-display text-2xl sm:text-3xl mt-3" style="letter-spacing:-0.03em">Propuestas ({topic.proposals})</h2>

        <div class="mt-10 space-y-10">
          {topicFile.groups.map((group) => (
            <div class="reveal">
              <h3 class="font-sans font-bold text-lg border-b border-tinta/10 pb-2.5">{group.title ?? 'Generales'}</h3>
              <ul class="mt-1 divide-y divide-tinta/10">
                {group.proposals.map((proposal) => {
                  const status = tracking.items?.[proposal.id]?.status;
                  return (
                    <li class="flex items-start gap-4 py-3.5">
                      <span class="font-mono text-xs font-semibold text-tintafina shrink-0 mt-0.5 min-w-[2.4rem]">{proposal.id.split('.')[1]}</span>
                      <p class="flex-1 text-sm leading-[1.7]">{proposal.text}</p>
                      {status && <Stamp status={status} />}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Primeros 100 días -->
    <section class="border-t border-tinta/10 bg-white/40">
      <div class="mx-auto max-w-4xl px-5 sm:px-8 py-14 sm:py-16">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Plan inmediato</p>
        <h2 class="font-display text-2xl sm:text-3xl mt-3" style="letter-spacing:-0.03em">Primeros 100 días</h2>
        <ul class="mt-8 bg-white rounded-lg border border-tinta/10 shadow-card divide-y divide-tinta/10">
          {topicFile.first_100_days.map((item) => (
            <li class="flex items-start gap-3.5 p-5">
              <span aria-hidden="true" class="mt-1 h-4 w-4 rounded-sm border-[1.5px] border-tinta/40 shrink-0"></span>
              <p class="text-sm leading-[1.7]">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Prev/next -->
    <nav class="border-t border-tinta/10" aria-label="Navegación entre temas">
      <div class="mx-auto max-w-4xl px-5 sm:px-8 py-8 flex items-center justify-between gap-4 font-sans text-sm font-medium">
        {prev
          ? <a href={`/temas/${prev.slug}/`} class="nav-link">← {prev.name}</a>
          : <span></span>}
        {next
          ? <a href={`/temas/${next.slug}/`} class="nav-link">{next.name} →</a>
          : <span></span>}
      </div>
    </nav>
  </main>
</Base>
