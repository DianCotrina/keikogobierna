---
import '../styles/global.css';
import Donate from '../components/Donate/Donate.astro';
import pkg from '../../package.json';

interface Props {
  title: string;
  description: string;
  activeNav?: string;
}

const { title, description, activeNav } = Astro.props;

const navLinks = [
  { key: 'tablero', label: 'Resumen', href: '/#tablero' },
  { key: 'temas', label: 'Temas', href: '/#temas' },
  { key: 'metodologia', label: 'Metodología', href: '/#metodologia' },
  { key: 'actualizaciones', label: 'Actualizaciones', href: '/#actualizaciones' },
  { key: '100dias', label: '100 días', href: '/primeros-100-dias/' }
];
---

<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Archivo+Black&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <noscript>
      <style>
        .reveal { opacity: 1; transform: none; }
      </style>
    </noscript>
  </head>
  <body class="grain font-serif text-tinta antialiased">
    <!-- Flag band -->
    <div class="h-1 bg-rojo" aria-hidden="true"></div>

    <!-- Header -->
    <header class="border-b border-tinta/10">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 flex items-center justify-between py-4">
        <a href="/" class="font-display text-lg tracking-tight lowercase">keiko<span class="text-rojo">gobierna</span></a>
        <nav class="hidden md:flex items-center gap-8 font-sans text-sm font-medium" aria-label="Navegación principal">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={link.key === '100dias' ? 'nav-chip' : 'nav-link'}
              aria-current={activeNav === link.key ? 'page' : undefined}
            >{link.label}</a>
          ))}
        </nav>
        <a href="/#alertas" class="btn-primary font-sans text-sm font-semibold bg-tinta text-papel px-4 py-2 rounded shadow-card">Recibir alertas</a>
      </div>
    </header>

    <slot />

    <footer class="border-t border-tinta/10">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-10">
        <div class="flex flex-col sm:flex-row items-start justify-between gap-10">
        <div class="max-w-md">
          <p class="font-display text-base lowercase">keiko<span class="text-rojo">gobierna</span></p>
          <a href="https://www.linkedin.com/in/diancotrina/" target="_blank" rel="noopener noreferrer" aria-label="Perfil de LinkedIn de Diego Cotrina" class="mt-4 inline-flex items-center justify-center w-8 h-8 rounded border-[1.5px] border-tinta/25 text-tintasuave hover:text-tinta hover:border-tinta/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-verde/60">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
            </svg>
          </a>
          <p class="mt-3 font-mono text-[0.65rem] text-tintafina">© 2026 keikogobierna · Todos los derechos reservados.</p>
          <p class="mt-1">
            <a href="https://github.com/DianCotrina/keikogobierna/releases" target="_blank" rel="noopener noreferrer" class="nav-link font-mono text-[0.65rem] text-tintafina" title="Historial de versiones">v{pkg.version}</a>
          </p>
        </div>
        <nav class="flex gap-12 sm:gap-16" aria-label="Enlaces del pie de página">
          <div>
            <p class="font-mono text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-tintafina">Fuentes</p>
            <ul class="mt-3 space-y-2 font-sans text-sm font-medium">
              <li><a href="/fuentes/" class="nav-link">Plan y fuentes oficiales</a></li>
            </ul>
          </div>
          <div>
            <p class="font-mono text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-tintafina">Contacto</p>
            <ul class="mt-3 space-y-2 font-sans text-sm font-medium">
              <li><a href="mailto:dian.cs183@gmail.com" class="nav-link">dian.cs183@gmail.com</a></li>
            </ul>
          </div>
          <div>
            <p class="font-mono text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-tintafina">Privacidad</p>
            <ul class="mt-3 space-y-2 font-sans text-sm font-medium">
              <li><a href="/privacidad/" class="nav-link">Política de privacidad</a></li>
            </ul>
          </div>
        </nav>
        </div>

        <p class="mt-10 border-t border-dashed border-tinta/20 pt-6 font-mono text-[0.65rem] text-tintasuave leading-relaxed">Proyecto ciudadano independiente. No está afiliado al gobierno ni a ningún partido político. Datos extraídos del plan de gobierno oficial. El seguimiento se actualiza con evidencia pública.</p>

        <blockquote class="mt-8 text-center">
          <p class="font-serif italic text-sm leading-[1.7] text-tintasuave max-w-2xl mx-auto">«No es lo que ignoras lo que te mete en problemas, sino lo que crees saber con certeza y que, en realidad, no es cierto.»</p>
          <cite class="mt-2 block font-mono text-[0.65rem] not-italic text-tintafina">— Mark Twain</cite>
        </blockquote>
      </div>
    </footer>

    <Donate />

    <script>
      function initReveal() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }

      initReveal();
    </script>
  </body>
</html>
