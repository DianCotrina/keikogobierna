---
// The plan's topics as cards, one block per pillar. Shared by the homepage
// section and the /temas/ hub; the hub passes `pillarAs="h2"` because there the
// pillar is a real heading under the page's H1, while on the homepage it sits
// below the section's own H2 as a label.
import TopicCard from './TopicCard.astro';

interface Topic {
  name: string;
  slug: string;
  proposals: number;
  progressPct: number;
  started: number;
}

interface Props {
  groups: { pillar: { id: string; name: string }; topics: Topic[] }[];
  pillarAs?: 'p' | 'h2';
}

const { groups, pillarAs = 'p' } = Astro.props;
const Label = pillarAs;
---

{groups.map(({ pillar, topics }, index) => (
  <div class:list={['mt-14 sm:mt-16', { 'mt-10 sm:mt-12': index === 0 }]}>
    <div class="reveal flex flex-wrap items-end justify-between gap-x-4 gap-y-1 border-b border-tinta/10 pb-3">
      <Label class="font-mono text-xs uppercase tracking-[0.18em] text-tintasuave">Pilar {index + 1} · {pillar.name.toUpperCase()}</Label>
      <p class="font-mono text-xs text-tintafina">{topics.length} temas</p>
    </div>
    <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {topics.map((topic) => (
        <TopicCard
          name={topic.name}
          slug={topic.slug}
          proposals={topic.proposals}
          progressPct={topic.progressPct}
          started={topic.started}
        />
      ))}
    </div>
  </div>
))}
