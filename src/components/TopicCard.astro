---
interface Props {
  name: string;
  slug: string;
  proposals: number;
  progressPct: number;
}

const { name, slug, proposals, progressPct } = Astro.props;
---

<a href={`/temas/${slug}/`} class="card-hover reveal block bg-white rounded-lg border border-tinta/10 shadow-card p-6">
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="font-sans font-bold text-lg">{name}</h3>
    <span class="font-mono text-xs text-tintafina whitespace-nowrap">{proposals} propuestas</span>
  </div>
  <div class="mt-4 h-1.5 rounded-full bg-tinta/10 overflow-hidden">
    <div class="h-full rounded-full bg-tinta" style={`width:${progressPct}%`}></div>
  </div>
  <p class="mt-3 font-mono text-xs text-tintasuave">{progressPct} % de avance</p>
</a>
