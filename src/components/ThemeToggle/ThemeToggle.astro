---
import './theme-toggle.css';

// Follows the visitor's system setting until they choose here. The theme itself
// is applied by the inline script in Base.astro. The button starts hidden and
// the client script reveals it: without JavaScript it couldn't do anything.
---

<button id="theme-toggle" type="button" class="theme-toggle" hidden>
  <svg class="theme-icon theme-icon--moon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
  </svg>
  <svg class="theme-icon theme-icon--sun" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <circle cx="10" cy="10" r="3.4" stroke="currentColor" stroke-width="1.7" />
    <path d="M10 2.2v2M10 15.8v2M2.2 10h2M15.8 10h2M4.5 4.5l1.4 1.4M14.1 14.1l1.4 1.4M4.5 15.5l1.4-1.4M14.1 5.9l1.4-1.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
  </svg>
</button>

<script src="./theme-toggle.ts"></script>
