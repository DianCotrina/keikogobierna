---
import RecordBadge from './RecordBadge.astro';

// A portfolio whose holder has been named in public but not yet appointed by
// norma.
//
// The card leads with what the public record says about the person — their
// profession and their judicial record — rather than with who reported the
// announcement. The press citation stays, demoted to a provenance line: the
// announcement is still a press claim and must remain checkable, but it is not
// what a reader came to find out.
interface Props {
  portfolio: { id: string; name: string; short: string };
  announcement: {
    person_name: string;
    announced: string;
    sources: Array<{ label: string; url: string }>;
    person: {
      slug: string;
      name: string;
      profession?: string;
      judicial?: Array<{ stage: string }>;
    } | null;
  };
}

const { portfolio, announcement } = Astro.props;
const person = announcement.person;
const displayName = person?.name ?? announcement.person_name;
---

<div class="reveal flex flex-col bg-white/70 rounded-lg border border-dashed border-ambar/50 p-6">
  <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-tintafina">
    {portfolio.short}
  </p>

  {person ? (
    <a href={`/gabinete/${person.slug}/`} class="nav-link font-sans font-bold text-lg mt-1.5 leading-snug self-start">
      {displayName}
    </a>
  ) : (
    <h3 class="font-sans font-bold text-lg mt-1.5 leading-snug">{displayName}</h3>
  )}

  {person?.profession && (
    <p class="mt-1 text-sm text-tintasuave">{person.profession}</p>
  )}
  <p class="mt-1 font-mono text-xs text-ambar">Anunciado · aún sin nombrar</p>

  <div class="mt-5 pt-4 border-t border-tinta/10">
    {person ? (
      <RecordBadge person={person} />
    ) : (
      <p class="text-sm leading-[1.7] text-tintasuave">
        Aún no publicamos su ficha: falta confirmar de qué persona se trata en los
        registros públicos. Un nombre en un titular no basta para identificarla.
      </p>
    )}
  </div>

  <p class="mt-4 font-mono text-[0.65rem] text-tintafina leading-relaxed">
    Pendiente de Resolución Suprema. Anuncio reportado por{' '}
    {announcement.sources.map((source, i) => (
      <>
        {i > 0 && ' · '}
        <a href={source.url} target="_blank" rel="noopener noreferrer" class="nav-link">{source.label}</a>
      </>
    ))}.
  </p>
</div>
