---
import Stamp from './Stamp.astro';
import EvidenceTrail from './EvidenceTrail/EvidenceTrail.astro';

interface Evidence {
  date: string;
  source: string;
  url?: string;
  note?: string;
}

interface Props {
  id: string;
  text: string;
  status?: string;
  evidence?: Evidence[];
}

const { id, text, status, evidence = [] } = Astro.props;
const certified = status === 'fulfilled';
---

<!-- On a phone the stamp sits above the text instead of beside it: beside it,
     it took a third of the row and squeezed the text and its evidence toggle
     into a narrow column. One stamp in both layouts, placed by the grid. -->
<li
  id={id}
  data-evidence-card
  class:list={[
    'commitment scroll-mt-24 grid grid-cols-[2.4rem_minmax(0,1fr)] sm:grid-cols-[2.4rem_minmax(0,1fr)_auto] gap-x-4 gap-y-1.5 items-start py-3.5',
    certified && 'bg-verde/[0.05] -mx-3 px-3 rounded-md',
  ]}
>
  <span class:list={['font-mono text-xs font-semibold text-tintafina mt-0.5 col-start-1 row-start-1', status && 'row-span-2 sm:row-span-1']}>{id.split('.')[1]}</span>
  {status && (
    <span class="col-start-2 row-start-1 justify-self-start sm:col-start-3 sm:justify-self-end">
      <Stamp status={status} />
    </span>
  )}
  <div class:list={['col-start-2', status ? 'row-start-2 sm:row-start-1' : 'row-start-1']}>
    <p class="text-sm leading-[1.7]">{text}</p>
    {evidence.length > 0 && <EvidenceTrail evidence={evidence} status={status} class="mt-2" />}
  </div>
</li>
