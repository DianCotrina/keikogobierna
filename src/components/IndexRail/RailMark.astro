---
interface Props {
  mark: 'in_progress' | 'fulfilled';
  /** True beside visible text that already says the status (the legend). */
  decorative?: boolean;
}

const { mark, decorative = false } = Astro.props;
const label = mark === 'in_progress' ? 'En progreso' : 'Cumplido';
const a11y = decorative ? { 'aria-hidden': 'true' } : { role: 'img', 'aria-label': label };
---

{mark === 'in_progress' ? (
  <svg
    class="rail-mark rail-mark--in_progress"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.15"
    stroke-linecap="round"
    stroke-linejoin="round"
    {...a11y}
  >
    {/* Mirror images about the neck, so the sand that lands after the turn has
        exactly the shape it started in. index-rail.css swaps them. */}
    <path class="rail-sand rail-sand--low" d="M5 13.8c.1-1.7 2.1-2.6 3-3.8.9 1.2 2.9 2.1 3 3.8Z" fill="currentColor" stroke="none" />
    <path class="rail-sand rail-sand--high" d="M5 2.2c.1 1.7 2.1 2.6 3 3.8.9-1.2 2.9-2.1 3-3.8Z" fill="currentColor" stroke="none" />
    <path d="M3.4 1.6h9.2M3.4 14.4h9.2" />
    <path d="M4.5 1.6v2.5c0 1.9 3.5 2.4 3.5 3.9 0-1.5 3.5-2 3.5-3.9V1.6" />
    <path d="M4.5 14.4v-2.5c0-1.9 3.5-2.4 3.5-3.9 0 1.5 3.5 2 3.5 3.9v2.5" />
  </svg>
) : (
  <svg
    class="rail-mark rail-mark--fulfilled"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    {...a11y}
  >
    <path d="M3 8.5 6.5 12 13 4.5" />
  </svg>
)}
