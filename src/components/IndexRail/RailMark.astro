---
interface Props {
  mark: 'in_progress' | 'fulfilled';
  /** True beside visible text that already says the status (the legend). */
  decorative?: boolean;
}

const { mark, decorative = false } = Astro.props;
const label = mark === 'in_progress' ? 'En progreso' : 'Cumplido';
---

<svg
  class={`rail-mark rail-mark--${mark}`}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...decorative ? { 'aria-hidden': 'true' } : { role: 'img', 'aria-label': label }}
>
  <path d="M3 8.5 6.5 12 13 4.5" />
</svg>
