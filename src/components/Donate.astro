---
import yapeQr from '../../assets/yape_donate_qr.jpeg';
import paypalQr from '../../assets/pp_donate_qr.png';

const PAYPAL_URL = 'https://www.paypal.com/donate/?hosted_button_id=MH32XPFFVPANS';
---

<!-- Donate widget -->
<div class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40 flex items-center gap-2">
  <div class="flex items-center gap-2.5 bg-white/95 backdrop-blur border border-tinta/15 rounded-full pl-4 pr-1.5 py-1.5 shadow-lift">
    <svg class="w-4 h-4 shrink-0 text-[#742384]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
    </svg>
    <span class="font-sans font-bold text-sm whitespace-nowrap">Apóyame con un</span>
    <button type="button" data-open="yape" aria-label="Donar por Yape" title="Yape" class="donate-icon relative block w-9 h-9 rounded-[10px] shadow-chip cursor-pointer border-0 p-0" style="background: radial-gradient(130% 130% at 25% 15%, #9B30AD, #6A1B7A 75%);">
      <span class="absolute inset-0 flex items-center justify-center font-sans italic font-bold text-white text-[13px]" style="letter-spacing:-0.02em; transform: rotate(-6deg);">yape</span>
      <span class="absolute -top-1.5 -left-1.5 w-4 h-4 rounded-full bg-[#3DDBD9] text-tinta text-[7.5px] font-sans font-bold flex items-center justify-center" style="border-bottom-right-radius:2px;">S/</span>
    </button>
    <button type="button" data-open="paypal" aria-label="Donar por PayPal" title="PayPal" class="donate-icon w-9 h-9 flex items-center justify-center rounded-[10px] cursor-pointer border-0 bg-transparent p-0">
      <svg viewBox="0 0 26 30" class="w-6 h-7" aria-hidden="true">
        <text x="1" y="22" font-family="Archivo, sans-serif" font-weight="800" font-style="italic" font-size="24" fill="#003087">P</text>
        <text x="8" y="26" font-family="Archivo, sans-serif" font-weight="800" font-style="italic" font-size="24" fill="#009CDE" opacity="0.92">P</text>
      </svg>
    </button>
  </div>
  <button id="share-btn" type="button" aria-label="Compartir esta página" title="Compartir" class="btn-ghost w-11 h-11 rounded-full bg-white/95 backdrop-blur border border-tinta/15 shadow-card flex items-center justify-center">
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/>
      <path d="M8.3 10.7l7.4-4.3M8.3 13.3l7.4 4.3"/>
    </svg>
  </button>
  <span id="share-toast" class="pointer-events-none absolute -top-9 right-0 font-mono text-[0.65rem] bg-tinta text-papel px-2.5 py-1 rounded opacity-0 transition-opacity duration-300">Enlace copiado</span>
</div>

<!-- Yape donation dialog -->
<dialog id="donate-yape" class="donate-dialog" aria-labelledby="donate-yape-title">
  <div class="donate-card">
    <div class="ticket">
      <div class="ticket-top">
        <button type="button" data-close aria-label="Cerrar" class="donate-close">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/>
          </svg>
        </button>
        <span class="stamp text-verde ticket-stamp" aria-hidden="true">Gracias</span>
        <p class="donate-eyebrow">Apóyame · Yape</p>
        <h2 id="donate-yape-title" class="donate-title">Dona con Yape</h2>
        <p class="donate-note">Escanea el código con la app de Yape para enviar tu aporte.</p>
      </div>
      <div class="ticket-bottom ticket-bottom--yape">
        <img src={yapeQr.src} width={yapeQr.width} height={yapeQr.height} alt="Código QR de Yape para donar, a nombre de Diego" class="yape-img" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</dialog>

<!-- PayPal donation dialog -->
<dialog id="donate-paypal" class="donate-dialog" aria-labelledby="donate-paypal-title">
  <div class="donate-card">
    <div class="ticket">
      <div class="ticket-top">
        <button type="button" data-close aria-label="Cerrar" class="donate-close">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/>
          </svg>
        </button>
        <span class="stamp text-verde ticket-stamp" aria-hidden="true">Gracias</span>
        <p class="donate-eyebrow">Apóyame · PayPal</p>
        <h2 id="donate-paypal-title" class="donate-title">Dona con PayPal</h2>
        <p class="donate-note">Escanea el código o usa el botón para donar por PayPal.</p>
      </div>
      <div class="ticket-bottom ticket-bottom--paypal">
        <div class="qr-chip">
          <img src={paypalQr.src} width={paypalQr.width} height={paypalQr.height} alt="Código QR de PayPal para donar" class="paypal-img" loading="lazy" decoding="async" />
        </div>
        <a href={PAYPAL_URL} target="_blank" rel="noopener noreferrer" class="paypal-btn">Dona usando PayPal →</a>
      </div>
    </div>
  </div>
</dialog>

<style>
  .donate-dialog {
    margin: auto; /* restore centering that Tailwind Preflight's universal margin:0 removes */
    border: 0;
    padding: 0;
    background: transparent;
    width: min(92vw, 21rem);
    max-height: 92vh;
    color: #141417;
    overflow: visible;
  }
  .donate-dialog::backdrop {
    background: rgba(20, 20, 23, 0.55);
  }

  /* Outer wrapper carries the drop shadow and rounds the corners. */
  .donate-card {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 2px 4px rgba(20,20,23,0.1), 0 18px 44px rgba(20,20,23,0.2), 0 44px 88px -40px rgba(20,20,23,0.4);
  }

  /* The ticket: two panels split by a punched perforation seam. */
  .ticket {
    --seam: 150px;
    -webkit-mask:
      radial-gradient(circle 10px at left var(--seam), #0000 10px, #000 0) left / 50.5% 100% no-repeat,
      radial-gradient(circle 10px at right var(--seam), #0000 10px, #000 0) right / 50.5% 100% no-repeat;
    mask:
      radial-gradient(circle 10px at left var(--seam), #0000 10px, #000 0) left / 50.5% 100% no-repeat,
      radial-gradient(circle 10px at right var(--seam), #0000 10px, #000 0) right / 50.5% 100% no-repeat;
  }

  .ticket-top {
    position: relative;
    box-sizing: border-box;
    height: var(--seam, 150px);
    background: #F5F3EE;
    padding: 1.7rem 1.5rem 1rem;
    text-align: center;
  }

  .ticket-bottom {
    position: relative;
    text-align: center;
    border-top: 2px dashed rgba(20, 20, 23, 0.18);
  }
  .ticket-bottom--paypal {
    background: linear-gradient(158deg, #0079C1 0%, #002E7A 100%);
    border-top-color: rgba(255, 255, 255, 0.3);
    padding: 1.5rem 1.5rem 1.7rem;
  }
  .ticket-bottom--yape {
    background: linear-gradient(158deg, #9B30AD 0%, #5A1568 100%);
    border-top-color: rgba(255, 255, 255, 0.25);
    padding: 1.35rem 1.35rem 1.5rem;
  }

  .donate-close {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: #46464D;
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s var(--ease-spring);
    z-index: 2;
  }
  .donate-close:hover { background: rgba(20, 20, 23, 0.06); }
  .donate-close:active { transform: scale(0.94); }

  .donate-eyebrow {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #46464D;
  }
  .donate-title {
    font-family: 'Archivo Black', Archivo, sans-serif;
    font-size: 1.55rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-top: 0.35rem;
  }
  .donate-note {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #46464D;
    margin: 0.5rem auto 0;
    max-width: 16rem;
  }

  .ticket-stamp {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    transform: rotate(-8deg);
    pointer-events: none;
    z-index: 2;
  }

  /* Yape: the official payment card sits on the purple stub. */
  .yape-img {
    display: block;
    width: 100%;
    max-width: 13.5rem;
    height: auto;
    margin: 0 auto;
    border-radius: 0.6rem;
  }

  /* PayPal: bare QR in a white chip + a light action button on the blue stub. */
  .qr-chip {
    width: fit-content;
    margin: 0 auto;
    background: #fff;
    padding: 0.8rem;
    border-radius: 0.6rem;
    box-shadow: 0 6px 18px rgba(0, 24, 60, 0.35);
  }
  .paypal-img {
    display: block;
    width: 10.5rem;
    height: 10.5rem;
  }
  .paypal-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.15rem;
    padding: 0.7rem 1.4rem;
    background: #fff;
    color: #003087;
    border-radius: 0.5rem;
    font-family: Archivo, sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    box-shadow: 0 6px 18px rgba(0, 24, 60, 0.3);
    transition: transform 0.25s var(--ease-spring), box-shadow 0.25s var(--ease-spring);
  }
  .paypal-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(0, 24, 60, 0.4); }
  .paypal-btn:active { transform: translateY(0) scale(0.98); }

  .donate-dialog[open] { animation: donate-in 0.28s var(--ease-spring); }
  .donate-dialog[open]::backdrop { animation: donate-backdrop-in 0.28s ease; }
  @keyframes donate-in {
    from { opacity: 0; transform: translateY(8px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  @keyframes donate-backdrop-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .donate-dialog[open], .donate-dialog[open]::backdrop { animation: none; }
    .donate-close { transition: none; }
    .paypal-btn { transition: none; }
  }
</style>

<script>
  function initDonate() {
    const btn = document.getElementById('share-btn');
    if (btn) {
      btn.addEventListener('click', async () => {
        const data = { title: document.title, url: location.href };
        if (navigator.share) {
          try { await navigator.share(data); } catch {}
        } else {
          try {
            await navigator.clipboard.writeText(location.href);
          } catch {
            return;
          }
          const toast = document.getElementById('share-toast');
          toast?.classList.remove('opacity-0');
          setTimeout(() => toast?.classList.add('opacity-0'), 1800);
        }
      });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((opener) => {
      const id = opener.getAttribute('data-open');
      const dialog = document.getElementById(`donate-${id}`) as HTMLDialogElement | null;
      if (!dialog) return;
      opener.addEventListener('click', () => dialog.showModal());
    });

    document.querySelectorAll<HTMLDialogElement>('dialog.donate-dialog').forEach((dialog) => {
      dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  }

  initDonate();
</script>
