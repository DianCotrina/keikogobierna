---
import './evidence-trail.css';
import { formatDateEsShort, plural, noteSegments, splitEvidenceNote } from '../../lib/format.mjs';
import { governmentDay } from '../../lib/mandate.mjs';

interface Evidence {
  date: string;
  source: string;
  url?: string;
  note?: string;
}

interface Related {
  id: string;
  text: string;
  topicName: string;
  topicSlug: string;
}

interface Props {
  evidence: Evidence[];
  status?: string;
  related?: Related[];
  class?: string;
}

const { evidence, status, related = [], class: className } = Astro.props;
const inProgress = status === 'in_progress';
const tone = inProgress ? 'text-ambar' : 'text-verde';
const dot = inProgress ? 'bg-ambar' : 'bg-verde';

// Same shape as TenureTimeline: this is a commitment's passage through the
// gazette, as that one is a person's passage through the cabinet.
// Oldest first: the trail reads as what happened, in the order it happened.
const trail = [...evidence]
  .sort((a, b) => a.date.localeCompare(b.date))
  .map((entry) => ({
    ...entry,
    ...splitEvidenceNote(entry.note),
    norma: entry.source.replace(/^El Peruano — /, ''),
  }));

const entryLabel = (index: number) => {
  if (!inProgress) return '✓ Verificado';
  return index === 0 ? 'Esta norma la puso en progreso' : 'Norma posterior';
};
---

<details class:list={['et', className]} data-evidence-trail>
  <summary class:list={['et-toggle', tone]}>
    <span class="et-when-closed">Ver más</span>
    <span class="et-when-open">Ver menos</span>
    <span class="font-normal normal-case tracking-normal">· {plural(trail.length, 'norma', 'normas')} en El Peruano</span>
    <svg class="et-chevron" viewBox="0 0 12 12" width="11" height="11" fill="none" aria-hidden="true">
      <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>

  <div class="et-body mt-4 space-y-5" data-et-body>
    <ol class="space-y-4">
      {trail.map((entry, index) => (
        <li class="relative pl-6 border-l-2 border-tinta/15">
          <span
            class:list={['absolute -left-[5px] top-1.5 w-2 h-2 rounded-full', index === trail.length - 1 ? dot : 'bg-tinta/25']}
            aria-hidden="true"
          />
          <p class="font-sans font-bold">{entryLabel(index)}</p>
          <p class="mt-0.5 font-mono text-xs text-tintasuave">
            {formatDateEsShort(entry.date)}
            <span class="text-tintafina"> · día {governmentDay(entry.date)} de gobierno</span>
          </p>
          {entry.does.length > 0 && (
            <p class="mt-1.5 text-sm leading-[1.7] text-tintasuave">
              {entry.does.map((part) => part.bold ? <strong class="font-semibold text-tinta">{part.text}</strong> : part.text)}
            </p>
          )}
          {entry.pending.length > 0 && (
            <p class="mt-1.5 text-sm leading-[1.7] text-tintasuave">
              <strong class="font-semibold text-tinta">Por qué sigue en progreso:</strong>{' '}
              {entry.pending.map((part) => part.bold ? <strong class="font-semibold text-tinta">{part.text}</strong> : part.text)}
            </p>
          )}
          <p class="mt-1.5 font-mono text-xs">
            {entry.url
              ? <a href={entry.url} target="_blank" rel="noopener noreferrer" class="nav-link">{entry.norma} ↗</a>
              : entry.norma}
          </p>
        </li>
      ))}
    </ol>

    {related.length > 0 && (
      <div class="pl-[26px]">
        <p class="font-sans text-sm font-bold">Esta evidencia también acredita avance en</p>
        <ul class="mt-1.5 space-y-1.5">
          {related.map((item) => (
            <li class="text-sm leading-[1.6] text-tintasuave">
              <a href={`/temas/${item.topicSlug}/#${item.id}`} class="nav-link font-mono text-xs font-semibold text-tinta">{item.topicName} {item.id.split('.')[1]}</a>
              {' '}{item.text}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</details>

<script src="./evidence-trail.ts"></script>
