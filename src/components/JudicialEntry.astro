---
import Stamp from './Stamp.astro';
import { LADDER, stageMeta, isAlleged, isPressOnly } from '../lib/judicial.mjs';
import { formatDateEs } from '../lib/format.mjs';
import type { JudicialEntry } from '../lib/cabinet-types';

// A single documented proceeding.
//
// The rail is the point: a criminal process genuinely is a sequence, so showing
// how far this case climbed carries real information — an investigation that
// went nowhere reads differently from one that reached a verdict. Exculpatory
// outcomes are rendered off the rail entirely, because they end a case rather
// than advance it. That is the rank-0 rule made visible.
interface Props {
  entry: JudicialEntry;
}

const { entry } = Astro.props;
const meta = stageMeta(entry.stage);
const resolved = meta.rank === 0;
const alleged = isAlleged(entry.stage);
const pressOnly = isPressOnly(entry);
const dateEs = formatDateEs(entry.date);
---

<article id={entry.id} class="reveal bg-white rounded-lg border border-tinta/10 shadow-card p-6 sm:p-7 scroll-mt-24">
  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
    <div class="min-w-0">
      <h3 class="font-sans font-bold text-lg leading-snug">{entry.case}</h3>
      <p class="mt-1 text-sm text-tintasuave">
        {alleged ? 'Presunto delito' : 'Delito'}: <span class="text-tinta">{entry.crime}</span>
      </p>
    </div>
    <Stamp label={meta.label} color={meta.color} />
  </div>

  {resolved ? (
    <p class="mt-5 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-verde">
      Proceso terminado · no constituye una acusación vigente
    </p>
  ) : (
    <div class="mt-5">
      <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-tintafina">
        Etapa alcanzada
      </p>
      <ol class="mt-2 flex items-end gap-1" aria-label={`Etapa alcanzada: ${meta.label}`}>
        {LADDER.map((rung) => {
          const reached = rung.rank <= meta.rank;
          return (
            <li
              class:list={[
                'flex-1 rounded-sm transition-transform',
                reached ? `bg-${meta.color}` : 'bg-tinta/10',
                reached ? 'h-3' : 'h-1.5',
              ]}
              title={rung.label}
            />
          );
        })}
      </ol>
      <p class="mt-2 font-mono text-[0.7rem] text-tintafina">
        {meta.rank} de {LADDER.length} etapas · {meta.label.toLowerCase()}
      </p>
    </div>
  )}

  <p class="mt-5 text-sm leading-[1.7] text-tintasuave">{entry.summary}</p>

  {alleged && (
    <p class="mt-3 font-mono text-[0.7rem] leading-[1.6] text-tintafina">
      Imputación presunta · el proceso sigue abierto y no hay responsabilidad declarada
    </p>
  )}

  {pressOnly && (
    <p class="mt-3 flex gap-2 font-mono text-[0.7rem] leading-[1.6] text-tintafina">
      <span aria-hidden="true">⚑</span>
      <span>
        Según prensa · no hemos contrastado la resolución. La consulta de expedientes del
        Poder Judicial exige un número de expediente que la nota no publica.
      </span>
    </p>
  )}

  <dl class="mt-4 grid gap-x-8 gap-y-1 sm:grid-cols-2 font-mono text-xs text-tintafina">
    {entry.body && (
      <div class="flex gap-2"><dt class="shrink-0">Órgano:</dt><dd class="text-tintasuave">{entry.body}</dd></div>
    )}
    <div class="flex gap-2">
      <dt class="shrink-0">{pressOnly ? 'Fecha del reporte:' : 'Fecha:'}</dt>
      <dd class="text-tintasuave">{dateEs}</dd>
    </div>
    {entry.expediente && (
      <div class="flex gap-2 sm:col-span-2"><dt class="shrink-0">Expediente:</dt><dd class="text-tintasuave break-all">{entry.expediente}</dd></div>
    )}
  </dl>

  <p class="mt-4 pt-4 border-t border-tinta/10 flex flex-wrap gap-x-6 gap-y-1 font-sans text-sm font-medium">
    {entry.sources.map((source) => (
      <a href={source.url} target="_blank" rel="noopener noreferrer" class="nav-link">
        {source.label} ↗
      </a>
    ))}
  </p>
</article>
